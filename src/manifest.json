{
  "manifest_version": 3,
  "name": "Local Input Translator (PLaMo)",
  "version": "0.1.0",
  "description": "PLaMo 3 Translate 0.8Bによる完全ローカル翻訳。Chromeの入力欄を53言語に変換します。",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "offscreen"],
  "host_permissions": ["https://huggingface.co/*", "https://cdn-lfs.hf.co/*", "https://cas-bridge.xethub.hf.co/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Local Input Translator" },
  "commands": {
    "translate-input": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "現在の入力欄を指定言語に翻訳して置換"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
